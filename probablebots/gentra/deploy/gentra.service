[Unit]
Description=gentra Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gentra
WorkingDirectory=/opt/gentra
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/gentra/.venv/bin/python /opt/gentra/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
